{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "functions": {
    "api/documents.js": {
      "includeFiles": "private-documents/**"
    },
    "api/uploads.js": {
      "includeFiles": "private-documents/**"
    }
  },
  "rewrites": [
    {
      "source": "/assets/file/:path*",
      "destination": "/api/documents?path=:path*"
    }
  ]
}
